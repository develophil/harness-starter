# 검증: codex execpolicy check --rules profiles/explore/codex.rules -- git status
# 버전 확인: prefix_rule 인자 문법은 설치 버전에서 재검증합니다.
prefix_rule(pattern = ["git", "status"], decision = "allow", justification = "작업 트리 조회")
prefix_rule(pattern = ["git", "diff"], decision = "allow", justification = "변경 내용 조회")
prefix_rule(pattern = ["rg"], decision = "allow", justification = "읽기 전용 검색")

